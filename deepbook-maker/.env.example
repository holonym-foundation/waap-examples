# deepbook-maker — copy to .env and edit. There is no key in this file, and none in
# the agent. Signing happens inside the WaaP enclave, reached only through waap-cli.

# --- Safety -------------------------------------------------------------------
# Dry run is ON unless this is exactly "0". In dry run the agent builds the
# unsigned transaction and stops; waap-cli is never invoked.
AGENT_DRY_RUN=1

# --- Network ------------------------------------------------------------------
NETWORK=mainnet
# The Mysten public fullnode retired JSON-RPC (-32601). publicnode still serves it.
# Backup: https://rpc-mainnet.suiscan.xyz. Check any endpoint you add answers before a long run.
SUI_RPC=https://sui-rpc.publicnode.com
# Endpoints tried after SUI_RPC when one fails in a way that is the NODE's fault — a
# transport error, HTTP 401/403/429/5xx, or a -32601 "method not found" from a node that
# has retired JSON-RPC.
# Every RPC read retries 3 times (1s / 3s / 9s) and rotates on each such failure; the
# DeepBookClient is rebuilt to match. Comma-separated; empty disables rotation.
# SUI_RPC_FALLBACKS=https://rpc-mainnet.suiscan.xyz
# Attempts per RPC read before the tick fails. Default 3.
# RPC_ATTEMPTS=3

# --- Market -------------------------------------------------------------------
# SDK pool key. DEEP_SUI on mainnet is
# 0xb663828d6217467c8a1838a03793da896cbe745b150ebd57d82f814ca579fc22 — whitelisted,
# zero taker and maker fee.
POOL_KEY=DEEP_SUI
# Full spread (ask minus bid) in basis points. Each side quotes half of it off mid.
SPREAD_BPS=20
# Size per side, in base units. DEEP/SUI: lot 1 DEEP, minimum 10 DEEP.
ORDER_SIZE=20
# A resting order further than this from its target gets cancelled and requoted.
REQUOTE_TOLERANCE_BPS=50
# How many level-2 ticks either side of mid to read.
BOOK_TICKS=5

# --- Inventory floors ---------------------------------------------------------
# These sit ON TOP of the size rule, they do not replace it. The agent never quotes a
# side it cannot back: no ask without ORDER_SIZE of DEEP, no bid without
# ORDER_SIZE x price of SUI. That is what makes a SUI-only start quote bids only.
# Base that must remain AFTER an ask is placed; below it the agent stops quoting asks.
BASE_FLOOR=0
# Quote that must remain AFTER a bid is placed; below it the agent stops quoting bids.
QUOTE_FLOOR=0

# --- Loop ---------------------------------------------------------------------
POLL_MS=60000
# Submit nothing on a tick with nothing to cancel, place or sweep. The main gas saver.
SKIP_EMPTY_TICK=1
# Consecutive failed ticks before the process exits 1. A failed tick sleeps the normal
# POLL_MS before the next one, so at the default this is ~20 failed polls, not a blip.
# Was 5, which a single ~100 s RPC outage could burn through and end a 24 h run.
# MAX_CONSECUTIVE_ERRORS=20
# Optional. Stop after N ticks and exit 0 — used for bounded, unattended runs.
# MAX_TICKS=65

# --- Objects and identity -----------------------------------------------------
# Created once and persisted in state.json. Set it here to reuse an existing one.
# DEEPBOOK_BALANCE_MANAGER_ID=0x...
# Skips `waap-cli whoami`. In a dry run it can be left unset: nothing is signed, so
# no session is needed and the agent logs dry_run_no_session.
# WAAP_AGENT_ADDRESS=0x...

# --- Files --------------------------------------------------------------------
STATE_FILE=./state.json
AGENT_LOG_FILE=./logs/deepbook-maker.jsonl
# PID_FILE=./agent.pid
# WRITE_PID_FILE=true

# --- Dry-run inventory override ----------------------------------------------
# Leave these unset for an ordinary dry run: the agent reads the real inventory.
# Set either one and, in a dry run only, it OVERRIDES the on-chain read - which is how
# the SUI-only bootstrap is rehearsed against a real, well-stocked BalanceManager:
#   DRY_RUN_BASE_INVENTORY=0 DRY_RUN_QUOTE_INVENTORY=10 npm run dev
# gives a bid-only quote_plan with skippedSides ["base_below_size"].
# They are also the fallback when the on-chain read fails (a manager that is not
# yours, or not yet on chain).
# DRY_RUN_BASE_INVENTORY=0
# DRY_RUN_QUOTE_INVENTORY=10

# --- One-shot scripts ---------------------------------------------------------
# npm run deposit - how much to move from the wallet into the BalanceManager, in human
# units. The manager must already exist. A SUI deposit splits from the gas coin; a DEEP
# deposit needs DEEP coin objects sitting in the wallet.
# DEPOSIT_SUI=25
# DEPOSIT_DEEP=0
# npm run stop - where the withdrawn coins land. Defaults to the agent's own wallet.
# WITHDRAW_RECIPIENT=0x...
# npm run refuse-probe - a deliberate deposit, in SUI, meant to exceed your daily spend
# limit. It must be smaller than your wallet balance: a deposit the wallet cannot cover
# is rejected at preparation, before the policy engine sees it.
PROBE_SUI=999

# --- Measurement (build-dryrun.ts) -------------------------------------------
# A Sui address holding SUI; it pays the simulated gas. Nothing is signed or sent.
# SIM_SENDER=0x...
