# deepbook-maker — copy to .env and edit. There is no key in this file, and none in
# the agent. Signing happens inside the WaaP enclave, reached only through waap-cli.

# --- Safety -------------------------------------------------------------------
# Dry run is ON unless this is exactly "0". In dry run the agent builds the
# unsigned transaction and stops; waap-cli is never invoked.
AGENT_DRY_RUN=1

# --- Network ------------------------------------------------------------------
NETWORK=mainnet
# The Mysten public fullnode retired JSON-RPC (-32601). publicnode still serves it.
# Backup: https://rpc-mainnet.suiscan.xyz. Check any endpoint you add answers before a long run.
SUI_RPC=https://sui-rpc.publicnode.com
# Endpoints tried after SUI_RPC when one fails in a way that is the NODE's fault — a
# transport error, HTTP 401/403/429/5xx, or a -32601 "method not found" from a node that
# has retired JSON-RPC.
# Every RPC read retries 3 times (1s / 3s / 9s) and rotates on each such failure; the
# DeepBookClient is rebuilt to match. Comma-separated; empty disables rotation.
# SUI_RPC_FALLBACKS=https://rpc-mainnet.suiscan.xyz
# Attempts per RPC read before the tick fails. Default 3.
# RPC_ATTEMPTS=3

# --- Market -------------------------------------------------------------------
# SDK pool key. DEEP_SUI on mainnet is
# 0xb663828d6217467c8a1838a03793da896cbe745b150ebd57d82f814ca579fc22 — whitelisted,
# zero taker and maker fee (read from chain every run; a fee change is picked up).
POOL_KEY=DEEP_SUI
BOOK_TICKS=5

# --- Strategy (lib/strategy.ts) ------------------------------------------------
# Largest order per side, base units. DEEP/SUI: lot 1, pool minimum 10 (read from chain).
# Gas is per transaction, so size is what makes the cost gate reachable — see README.
ORDER_SIZE=20
# Narrowest full spread (ask − bid) in bps. The cost gate widens it as needed.
SPREAD_BPS=20
# Widest spread the maker will quote. Above it: pause and cancel, never widen further.
MAX_SPREAD_BPS=400
# Liquidity rule: our spread may be at most this multiple of the touch spread
# (own orders excluded). A declared heuristic, not a fill model.
TOUCH_MULTIPLE=4
# The rule decides where NEW quotes go; it is not a risk limit. A pause caused only by it
# keeps resting orders the keep rules keep (0 restores cancel-all). Once paused, placing
# resumes only after LIQUIDITY_MIN_PAUSE_MIN and with the spread inside the rule by
# LIQUIDITY_RESUME_MARGIN (0.25 → at most 75% of the limit). Live run 2b without this:
# 12 of 15 sends were pause/resume flips; replayed with it: 8 sends, none a flip.
HOLD_ON_LIQUIDITY_PAUSE=1
LIQUIDITY_RESUME_MARGIN=0.25
LIQUIDITY_MIN_PAUSE_MIN=10
# Inventory band: base share of manager value. Orders are sized so a full fill keeps
# the share inside [BAND_LOW, BAND_HIGH]. Capital needed ≈ q × mid / (BAND_HIGH − target).
TARGET_BASE_FRACTION=0.5
BAND_LOW=0.2
BAND_HIGH=0.8
# Quote centre moves up to this far off mid toward the side that restores the target.
SKEW_MAX_BPS=50
# A drifted order is replaced only past the tolerance AND after the dwell. Risk
# (band, cap, expiry, pause, halt) cancels regardless of dwell.
REQUOTE_TOLERANCE_BPS=50
MIN_DWELL_SEC=300
# Orders expire on chain after this; replaced this long before expiry. Expiry is what
# bounds a crashed process's exposure. Must exceed POLL_MS + REFRESH_BEFORE_EXPIRY_MIN.
ORDER_TTL_MIN=60
REFRESH_BEFORE_EXPIRY_MIN=5
# The book read must be this fresh to quote.
STALE_BOOK_SEC=30
# Cost model (lib/costs.ts): replacements per filled cycle, cycles that setup and
# cleanup are amortised over, and the quantile of historical shape costs (median|p90|max).
COST_REPLACEMENTS_PER_CYCLE=3
COST_CYCLES_TO_AMORTIZE=10
COST_QUANTILE=p90
# Pay fees in DEEP. With a nonzero fee, DEEP_FEE_RESERVE (base units) must be set or
# the maker pauses (fee_reserve_unconfigured).
PAY_WITH_DEEP=true
# DEEP_FEE_RESERVE=0

# --- Limits (lib/budget.ts) ----------------------------------------------------
# Gas: consumed (never reduced by rebates) + reserved for sends awaiting receipts.
GAS_CAP_SUI=0.15
# Extra room only cleanup may use, so cleanup stays possible when trading is exhausted.
CLEANUP_GAS_ALLOWANCE_SUI=0.05
# Reserved per send until its receipt is counted (largest net seen ≈ 0.0047).
GAS_RESERVE_PER_TX_SUI=0.006
# Inventory drawdown (manager value at mid vs run start, gas excluded) that ends the run.
MAX_DRAWDOWN_SUI=0.05
# Confirmed filled notional in the rolling window; reaching it pauses new orders.
MAX_TURNOVER_SUI=20
TURNOVER_WINDOW_HOURS=24
# Wall-clock run length in minutes; 0 = none. The run ends through cleanup.
MAX_RUN_MIN=0
# A tick with nothing to change submits nothing (unless settled proceeds need sweeping).
# Ticks the maker may stay inventory-limited before it ends the run through cleanup.
INVENTORY_LIMITED_EXIT_TICKS=10

# --- Loop ---------------------------------------------------------------------
POLL_MS=60000
# Consecutive failed ticks before the run ends through cleanup.
# MAX_CONSECUTIVE_ERRORS=20
# Optional: end (through cleanup) after N ticks.
# MAX_TICKS=65
# Fill scan pages per tick; a restart's backfill continues across ticks, quoting paused.
# FILL_SCAN_PAGES=8
# Skip the restart backfill. Turnover and P&L for the run are then marked incomplete.
# FILL_SKIP_GAP=0

# --- Objects and identity -----------------------------------------------------
# Created by the first live tick and persisted in the state file. If you set it here,
# it must match the state file — a mismatch is refused by every script.
# DEEPBOOK_BALANCE_MANAGER_ID=0x...
# No state file but a manager above: refused unless ADOPT_MANAGER=1, which starts a new
# run whose budgets and starting value are measured from the chain now. Implied in dry run.
# ADOPT_MANAGER=0
# Skips `waap-cli whoami`. In a dry run it can be left unset.
# WAAP_AGENT_ADDRESS=0x...

# --- Files --------------------------------------------------------------------
# Default ./state.json live, ./state.dry.json dry. A dry state is never read live.
# STATE_FILE=./state.json
AGENT_LOG_FILE=./logs/deepbook-maker.jsonl
# One lock per account, network and pool lives here (default ~/.deepbook-maker/locks).
# LOCK_DIR=

# --- Dry-run inventory --------------------------------------------------------
# In a dry run only, these replace the on-chain read so a first dry run has something
# to plan with (about 1.9 SUI of value, balanced). Ignored live.
DRY_RUN_BASE_INVENTORY=50
DRY_RUN_QUOTE_INVENTORY=0.955

# --- One-shot scripts ---------------------------------------------------------
# npm run deposit - how much to move from the wallet into the BalanceManager, in human
# units. The manager must already exist, and the loop must not be running (shared lock). A SUI deposit splits from the gas coin; a DEEP
# deposit needs DEEP coin objects sitting in the wallet.
# DEPOSIT_SUI=25
# DEPOSIT_DEEP=0
# Where cleanup (loop exit or npm run stop) sends the coins. Defaults to the agent's wallet.
# WITHDRAW_RECIPIENT=0x...
# npm run stop waits this long for a live loop to finish its own cleanup.
# STOP_WAIT_SEC=600
# npm run refuse-probe - a deliberate deposit, in SUI, meant to exceed your daily spend
# limit. It must be smaller than your wallet balance: a deposit the wallet cannot cover
# is rejected at preparation, before the policy engine sees it.
PROBE_SUI=999

# --- Measurement (build-dryrun.ts) -------------------------------------------
# A Sui address holding SUI; it pays the simulated gas. Nothing is signed or sent.
# SIM_SENDER=0x...
